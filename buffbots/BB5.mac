|------------------------------------------------------------|
|          All Buffs on Hail
|------------------------------------------------------------|

Sub CheckNetBots(string Someone)
	/declare client int local 0
	/declare clients string local ${NetBots.Clients}
	/declare numClients int local ${NetBots.Counts}
	/declare currClient string local NULL
	/if (${numClients} > 0) {
		/for client 1 to ${numClients}
		/varset currClient ${clients.Arg[${client}]}
		/if (${NetBots[${currClient}].Equal[${Someone}]} && ${NetBots[${currClient}].MacroName.Equal[${Macro.Name}]}) /return ${Bool[1]}
	/next client
	}
/return ${Bool[0]}

|------------------------------------------------------------|
|          End All Buffs on Hail
|------------------------------------------------------------|
|------------------------------------------------------------|
|          Teleport Bind for Western Waste
|------------------------------------------------------------|

Sub Event_WWTwo(string line, string who, string what)
/if (${Me.Class.ShortName.NotEqual[DRU]} && ${Me.Class.ShortName.NotEqual[WIZ]}) /return
/declare spaces int local ${what.Count[ ]}
/declare numPeople int local 1
/declare i int local 0
/declare tempWho string local
/if (${what.Length}) /varset numPeople ${Math.Calc[${numPeople} + ${spaces} + 1].Int}

| Distance check is 100 because that's the radius where the teleport will land.
/if (${Me.AltAbilityReady[Teleport Bind]}) {
    /if (${Spawn[${who}].ID} && ${Spawn[${who}].Distance} < 100) {
        /invite ${who}
		/tell ${who} Please take invite for port to The Western Waste!
        /if (${numPeople} > 1) {
            /for i 1 to ${numPeople}
                /varset tempWho ${what.Arg[${i}]}
                /if ( ${Spawn[${tempWho}].ID} && ${Spawn[${tempWho}].Distance} < 100) {
                    /tell ${tempWho} Please take invite for port to The Western Waste!
                    /invite ${tempWho}
                } else {
                    /tell ${tempWho} You're too far away, skipping you.
                }
            /next i
        }
    } else {
        /tell ${who} Nice try dumbass, come stand next to me and try again!
        /return
    }
} else {
    /tell ${who} Teleport Bind is currently on cooldown for ${Math.Calc[${Me.AltAbilityTimer[Teleport Bind]}/60000]}min, try again later.
    /return
}
/declare groupWaitTimer timer local 1m
:groupwait
/delay 5
/echo Group has ${Group.Members} people, needs ${numPeople} people.
/if (${Group.Members} < ${numPeople} && ${groupWaitTimer} > 0) /goto :groupwait
/if (!${groupWaitTimer}) {
    /tell ${who} The group failed to form in time, canceling this port.
    /disband
    /return
}

/g Thanks for flying with ${Me.CleanName}'s airlines, please fasten your seatbelts. Takeoff in 15s.
/delay 5s

| 7009 is Teleport Bind
/alt act 7009
/return


Sub Event_WWTwoReturnTrip(string line)
/if (${Me.Class.ShortName.NotEqual[DRU]} && ${Me.Class.ShortName.NotEqual[WIZ]}) /return
/echo Gating back.
/g Hope you enjoyed you ride on ${Me.CleanName}'s airlines, happy hunting!
/delay 1s
/disband
/cast "Primary Anchor Ring"
/return

|------------------------------------------------------------|
|          End Teleport Bind for Western Waste
|------------------------------------------------------------|