|------------------------------------------------------------|
|          Enchanter
|------------------------------------------------------------|
	/if (${Me.Class.Name.Equal[Enchanter]} && !${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Spells,1-45 Haste].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Spells" "1-45 Haste" "Swift Like the Wind|gem1"
	/Declare EncLowLvlBuff1	string outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Spells,1-45 Haste]}
	/Declare EncLowLvlBuff1Gem	string outer
	/if (${Me.Class.Name.Equal[Enchanter]} && ${EncLowLvlBuff1.Find[|]}) {
		/varset EncLowLvlBuff1 ${EncLowLvlBuff1.Arg[1,|]}
		/varset EncLowLvlBuff1Gem ${EncLowLvlBuff1.Arg[2,|]}
	}
	/if (${Me.Class.Name.Equal[Enchanter]} && !${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Spells,1-41 Clarity].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Spells" "1-41 Clarity" "Boon of the Clear Mind|gem2"
	/Declare EncLowLvlBuff2	string outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Spells,1-41 Clarity]}
	/Declare EncLowLvlBuff2Gem	string outer
	/if (${Me.Class.Name.Equal[Enchanter]} && ${EncLowLvlBuff2.Find[|]}) {
		/varset EncLowLvlBuff2 ${EncLowLvlBuff2.Arg[1,|]}
