	/Declare GuildFree		bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Guild Buffs Free]}
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Starting Balance].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Account" "Starting Balance" "5000"
