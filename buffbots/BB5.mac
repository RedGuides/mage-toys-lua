	/Declare Advertise				bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Advertise]}
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Port Gem].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "General" "Port Gem" "gem8"
	/Declare PortGem				string outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Port Gem]}
|-----------Accounts-----------------------------------------|
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Use Account Mode].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Account" "Use Account Mode" "FALSE"
	/Declare AccountMode		bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Use Account Mode]}
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Use Friend Mode].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Account" "Use Friend Mode" "FALSE"
	/Declare FriendMode		bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Use Friend Mode]}
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Friends Buff Free].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Account" "Friends Buff Free" "FALSE"
	/Declare FriendFree		bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Friends Buff Free]}
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,Account,Use Guild Mode].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "Account" "Use Guild Mode" "FALSE"
