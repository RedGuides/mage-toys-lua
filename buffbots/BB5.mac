|------------------------------------------------------------|
|          Main Rountine
|------------------------------------------------------------|
| --------------------------------------------------------------------------------------------
| SUB: Main
| --------------------------------------------------------------------------------------------
Sub Main
/echo macro started
	/call Declares
	/if (${ShowDebug}) DEBUGCHAT [${Macro.Name} @ ${Macro.CurLine}] ---> Sub Main Entry
	/if (${UseLowResourceMode}) /call LowerEQResources
	/afk ${AFKMessage}
	/tgb on

	/popup ALL VARIABLES LOADED: Check Mq2 Window for Errors.
	/if (${UseEQBC}) /bccmd connect ${EQBCServerAddr} ${EQBCPort} ${EQBCPassword}

	CHATMETHOD1 [NBB]+ Initialized ++[NBB]
	CHATMETHOD [NBB]+ Initialized ++[NBB]
	CHATMETHOD1 [NBB]++ NEWBIE BUFF BOT STARTED ++[NBB]
	CHATMETHOD [NBB]++ NEWBIE BUFF BOT STARTED ++[NBB]

	:MainLoop
	/if (${MacroQuest.GameState.Equal[CHARSELECT]}) /end
	/if (${Cursor.ID}) /autoinventory
	/if (!${Me.AFK}) /afk ${AFKMessage}
	/if (${Me.PctMana} < ${MedAtPct}) /call Med
	/if (${Window[TradeWnd].Open}) /call Money
	/if (!${Me.Mount.ID} && ${UseHorse} && ${Zone.Type}==1 && ${FindItem[${HorseItem}].Name.NotEqual["NULL"]}) /call CASTMODE "${FindItem[${HorseItem}]}" item
	/if (${Me.Standing} && !${Me.Mount.ID} && (!${UseHorse} || ${UseHorse} && ${FindItem[${HorseItem}].Name.Equal["NULL"]})) /sit
	/doevents
	/if (${MacroQuest.GameState.Equal[CHARSELECT]}) /end
	/delay 7
	/goto :MainLoop
/return
|------------------------------------------------------------|
|          End Main Rountine
|------------------------------------------------------------|

Sub Declares
/if (${ShowDebug}) DEBUGCHAT [${Macro.Name} @ ${Macro.CurLine}] ---> Sub Declares Entry
|-----------Buffs--------------------------------------------|
| /declare


|-----------Guild--------------------------------------------|
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Buff Guild Only].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "General" "Buff Guild Only" "TRUE"
	/Declare BuffGuildOnly		bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Buff Guild Only]}
|-----------Debug--------------------------------------------|
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,ShowDebug].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "General" "ShowDebug" "FALSE"
	/Declare ShowDebug			bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,ShowDebug]}
|-----------Debug--------------------------------------------|
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,UseLowResourceMode].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "General" "UseLowResourceMode" "FALSE"
	/Declare UseLowResourceMode			bool outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,UseLowResourceMode]}
|-----------Toy Request Cap----------------------------------|
	/if (!${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Max Summon Requests].Length}) /call SetIni "BuffBot_${EverQuest.Server}_${Me.CleanName}.ini" "General" "Max Summon Requests" "20"
	/Declare MaxRequests			int outer ${Ini[BuffBot_${EverQuest.Server}_${Me.CleanName}.ini,General,Max Summon Requests]}
